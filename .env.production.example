# Database Configuration
POSTGRES_USER=traceforge_prod
POSTGRES_PASSWORD=generate_a_secure_random_password_here
POSTGRES_DB=traceforge

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT and Security
JWT_SECRET=generate_a_secure_random_jwt_secret_here

# API Limits
DISABLE_NGINX_RATE_LIMIT=false

# External APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URLs
NEXT_PUBLIC_API_URL=https://api.usetraceforge.com
NEXT_PUBLIC_REALTIME_URL=https://realtime.usetraceforge.com
FRONTEND_PORT=3000

# Cloudflare R2 Storage (Optional, for offloading Source Maps)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=traceforge-sourcemaps
