# Database Configuration
POSTGRES_USER=traceforge_prod
POSTGRES_PASSWORD=generate_a_secure_random_password_here
POSTGRES_DB=traceforge

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT and Security
JWT_SECRET=generate_a_secure_random_jwt_secret_here

# API Limits
DISABLE_NGINX_RATE_LIMIT=false

# External APIs
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URLs
NEXT_PUBLIC_API_URL=https://api.usetraceforge.com
NEXT_PUBLIC_REALTIME_URL=https://realtime.usetraceforge.com
FRONTEND_PORT=3000
