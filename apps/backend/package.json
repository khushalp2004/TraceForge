{
  "name": "traceforge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cluster": "tsx watch src/cluster.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:cluster": "node dist/cluster.js",
    "postinstall": "prisma generate",
